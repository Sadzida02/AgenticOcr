{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalPrescriptionReport",
  "type": "object",
  "properties": {
    "document_id": { "type": "string" },
    "raw_text": { "type": "string" },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "raw_text": { "type": "string" },
          "normalized_drug_name": { "type": [ "string", "null" ] },
          "strength": { "type": [ "string", "null" ] },
          "dose_form": { "type": [ "string", "null" ] },
          "route": { "type": [ "string", "null" ] },
          "frequency": { "type": [ "string", "null" ] },
          "duration": { "type": [ "string", "null" ] },
          "confidence": { "type": "number" },
          "needs_human_review": { "type": "boolean" },
          "uncertainties": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "required": [
          "raw_text",
          "confidence",
          "needs_human_review",
          "uncertainties"
        ]
      }
    },
    "global_confidence": { "type": "number" },
    "review_required": { "type": "boolean" },
    "audit_log": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "document_id",
    "raw_text",
    "medications",
    "global_confidence",
    "review_required",
    "audit_log"
  ]
}
